# ==============================================================================
# ShelfSaathi Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure frontend/.env and backend/.env separately.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shelfsaathi
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=placeholder-jwt-secret-from-supabase-settings
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-do-not-commit
SUPABASE_STORAGE_BUCKET=invoices

# AI Vision & Extraction
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=placeholder-ai-key-do-not-commit
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# External Lookup Services
OPEN_FOOD_FACTS_ENABLED=false
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Observability and Limits
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORE_URL=

# ------------------------------------------------------------------------------
# Frontend Configuration (Browser-visible variables must use VITE_ prefix)
# NEVER put DATABASE_URL, AI keys, or service role keys in VITE_* variables.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key-safe-for-browser

