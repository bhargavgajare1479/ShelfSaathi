# Backend Environment Configuration Template
# Required by ARCHITECTURE.md and API.md
# Never commit real credentials to version control.

APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shelfsaathi

# Supabase Auth and Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=placeholder-jwt-secret-from-supabase-settings
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-do-not-commit
SUPABASE_STORAGE_BUCKET=invoices

# AI Extraction Provider
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=placeholder-ai-key-do-not-commit
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# External Product Lookup
OPEN_FOOD_FACTS_ENABLED=false
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org

# Logging & Operational Controls
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=false
RATE_LIMIT_STORE_URL=

