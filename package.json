{
  "name": "shelfsaathi-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "ShelfSaathi mobile-first AI inventory and purchasing assistant for kirana stores and small retailers",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "cd frontend && npm run build",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && source .venv/bin/activate && ruff check .",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && source .venv/bin/activate && pytest",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
